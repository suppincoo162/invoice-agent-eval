# Optional independent LLM audit. Never commit a real API key.
# Cloud OpenAI-compatible endpoint:
INVOICE_EVAL_LLM_BASE_URL=https://your-provider.example/v1
INVOICE_EVAL_LLM_MODEL=your-model-id
INVOICE_EVAL_LLM_API_KEY=replace-with-environment-secret
INVOICE_EVAL_LLM_TIMEOUT=60

